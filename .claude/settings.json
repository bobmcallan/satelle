{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "sh .satelle/hooks/pretooluse-gate-claude.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "sh .satelle/hooks/pretooluse-commitgate-claude.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "satelle reindex",
            "type": "command"
          },
          {
            "command": "satelle hook context",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "PATH=$HOME/.local/bin:$PATH satelle hook stopcheck",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "PATH=$HOME/.local/bin:$PATH satelle hook prompt",
            "type": "command"
          }
        ]
      }
    ]
  }
}
