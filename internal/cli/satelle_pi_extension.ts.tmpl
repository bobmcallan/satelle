// satelle-owned: pi extension — written by `satelle agents install pi`; removed by `satelle agents remove pi`.
// Do not edit: `satelle init` rewrites it from the binary when it drifts.
//
// What this file is. pi has no hook config file, so this extension is the only
// mechanism that lets a pi session be held to the same satelle hooks the claude
// and grok scaffolds wire (sty_b3c7b37d). It maps the four satelle hook events
// onto pi's extension events and calls the SAME `satelle hook <verb>` handlers.
// Nothing is decided here: every verdict comes from satelle; this file only
// carries a claude-shaped event in and a pi-shaped result out.
//
// Two invocation forms, mirroring the claude scaffold event for event:
//
//   wrapper  PreToolUse. `sh .satelle/hooks/satelle-hook.sh <gate|commitgate> pi`.
//            The wrapper owns the PreToolUse policy and is fail-VISIBLE: an
//            unusable satelle becomes a deny (non-mutating bash stays allowed).
//            The only transport rule here is the same one: if the wrapper cannot
//            run at all, an edit is blocked and so is `git commit` / `git push`.
//   direct   SessionStart, UserPromptSubmit, Stop. `satelle hook <verb> --harness pi`.
//            These fail OPEN by design, exactly as claude's direct commands do: a
//            missing or failing satelle never wedges a session, it only notifies.
//
// A deny is ENFORCED by pi, not logged: a tool_call handler returning
// `{ block: true, reason }` stops the tool, and a handler that throws blocks it
// too (docs/extensions.md, "Errors and cleanup").
//
// Stop is the one event pi cannot veto. `agent_settled` is notification-only, so
// a refused stop is delivered as a user message that starts another turn: the
// agent cannot settle silently on an ungated edit, it has to answer. That is a
// re-prompt, not a veto — a user who kills the session is not held. As with
// claude, satelle's own anti-loop applies: a re-prompt is sent with
// stop_hook_active, so stopcheck never blocks its own block twice in one chain.
//
// A gate the session handed off is told once. A settle runs stopcheck, which
// waits for the gate up to its own bound and answers with the verdict as a block
// — sent here as one user message — or, when the gate is still going, allows the
// stop and names it as pending. A pending gate arms ONE waiter, which asks
// stopcheck again: each ask is a blocking wait on the handle inside the hook,
// never a timer or a poll, and the verdict is sent once when it arrives. Nothing
// is re-sent on a later settle: the verdict is claimed by whichever of the stop
// hook and the prompt hook (before_agent_start, additionalContext) reaches it
// first.
//
// A non-interactive run (print or JSON mode: no UI, so ctx.hasUI is false) ends
// at agent_settled and nothing can send it a later message. It asks stopcheck
// with --no-wake, which waits for nothing and records an adapter-named limitation
// for each gate left undelivered; those verdicts stay unclaimed, so the next
// session's prompt still delivers them.
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { spawn, type ChildProcess } from "node:child_process";

const REPO_ROOT: string = __SATELLE_REPO_ROOT__;
const WRAPPER: string = __SATELLE_WRAPPER__;

// BEGIN satelle bindings (generated from the harness hook table)
const BINDINGS: Binding[] = __SATELLE_BINDINGS__;
// END satelle bindings

interface Binding {
	event: string;
	pi: string;
	form: "wrapper" | "direct";
	verb: string;
	argv?: string[];
	tools?: string;
	timeout_s: number;
}

interface Run {
	spawnError?: string;
	timedOut: boolean;
	code: number | null;
	stdout: string;
	stderr: string;
}

// pi's built-in tool ids -> the tool names the satelle gates recognise.
const CLAUDE_TOOL: Record<string, string> = { edit: "Edit", write: "Write", bash: "Bash" };
const MUTATING_GIT = /git\s+(commit|push)\b/;

function childEnv(): Record<string, string | undefined> {
	const home = process.env.HOME ?? "";
	const path = process.env.PATH ?? "";
	return {
		...process.env,
		// The session home: the wrapper and the containment check both anchor on it.
		SATELLE_PROJECT_DIR: REPO_ROOT,
		PATH: home ? `${home}/.local/bin:${path}` : path,
	};
}

// Every satelle process this extension has running, so the waiter below can be
// stopped when pi exits: a hook left waiting on a gate would claim a verdict
// that nobody is left to receive.
const children = new Set<ChildProcess>();

function run(cmd: string, args: string[], input: string, cwd: string, timeoutS: number): Promise<Run> {
	return new Promise((resolve) => {
		let stdout = "";
		let stderr = "";
		let timedOut = false;
		let done = false;
		let timer: ReturnType<typeof setTimeout> | undefined;
		const finish = (r: Run) => {
			if (done) return;
			done = true;
			if (timer) clearTimeout(timer);
			resolve(r);
		};
		let child;
		try {
			child = spawn(cmd, args, { cwd, env: childEnv(), stdio: ["pipe", "pipe", "pipe"] });
		} catch (e) {
			finish({ spawnError: String(e), timedOut: false, code: null, stdout, stderr });
			return;
		}
		timer = setTimeout(() => {
			timedOut = true;
			child.kill("SIGKILL");
		}, timeoutS * 1000);
		children.add(child);
		child.on("close", () => children.delete(child));
		child.stdout.on("data", (d) => (stdout += d));
		child.stderr.on("data", (d) => (stderr += d));
		child.on("error", (e) => finish({ spawnError: String(e), timedOut, code: null, stdout, stderr }));
		child.on("close", (code) => finish({ timedOut, code, stdout, stderr }));
		child.stdin.on("error", () => {});
		child.stdin.end(input);
	});
}

function sessionId(ctx: any): string | undefined {
	try {
		const id = ctx?.sessionManager?.getSessionId?.();
		return id ? String(id) : undefined;
	} catch {
		return undefined;
	}
}

function workdir(ctx: any): string {
	return typeof ctx?.cwd === "string" && ctx.cwd ? ctx.cwd : REPO_ROOT;
}

// The single owner of pi -> claude-shaped normalisation. The Go side receives
// only `--harness pi`; it never sniffs a pi payload.
function claudeEvent(name: string, ctx: any, extra: Record<string, unknown>): string {
	const ev: Record<string, unknown> = { hook_event_name: name, cwd: workdir(ctx), ...extra };
	const sid = sessionId(ctx);
	if (sid) ev.session_id = sid;
	return JSON.stringify(ev);
}

function notify(ctx: any, msg: string, level: "info" | "warning" | "error" = "warning"): void {
	try {
		if (ctx?.hasUI) ctx.ui.notify(msg, level);
	} catch {
		// a notification must never be able to fail a hook
	}
}

function parseJSON(text: string): any {
	const t = text.trim();
	if (!t) return undefined;
	try {
		return JSON.parse(t);
	} catch {
		return null;
	}
}

function bindingsFor(piEvent: string): Binding[] {
	return BINDINGS.filter((b) => b.pi === piEvent);
}

function toolBinding(toolName: string): Binding | undefined {
	return BINDINGS.find((b) => b.form === "wrapper" && b.tools && new RegExp(`^(?:${b.tools})$`).test(toolName));
}

// The wrapper's answer for one PreToolUse. Empty stdout is an allow; a
// permissionDecision of deny is the verdict; anything else means satelle could
// not decide, which is the infrastructure case handled by the caller.
type Verdict = { kind: "allow" } | { kind: "deny"; reason: string } | { kind: "infra"; why: string };

function wrapperVerdict(r: Run): Verdict {
	if (r.spawnError) return { kind: "infra", why: r.spawnError };
	if (r.timedOut) return { kind: "infra", why: "timed out" };
	const doc = parseJSON(r.stdout);
	const hso = doc?.hookSpecificOutput;
	if (hso?.permissionDecision === "deny") {
		return { kind: "deny", reason: String(hso.permissionDecisionReason ?? "satelle: denied") };
	}
	if (r.code === 0 && doc === undefined) return { kind: "allow" };
	return { kind: "infra", why: r.stderr.trim() || r.stdout.trim() || `exit ${r.code}` };
}

// A direct hook's answer. ok=false is an infrastructure failure, which the
// caller treats as fail-open.
function directResult(r: Run): { ok: boolean; doc: any; why: string } {
	if (r.spawnError) return { ok: false, doc: undefined, why: r.spawnError };
	if (r.timedOut) return { ok: false, doc: undefined, why: "timed out" };
	if (r.code !== 0) return { ok: false, doc: undefined, why: r.stderr.trim() || `exit ${r.code}` };
	const doc = parseJSON(r.stdout);
	if (doc === null) return { ok: false, doc: undefined, why: "unparseable output" };
	return { ok: true, doc, why: "" };
}

async function runDirect(b: Binding, payload: string, ctx: any, extra: string[] = []) {
	const argv = [...(b.argv ?? ["hook", b.verb, "--harness", "pi"]), ...extra];
	const r = await run("satelle", argv, payload, workdir(ctx), b.timeout_s);
	const d = directResult(r);
	if (!d.ok) notify(ctx, `satelle ${argv.join(" ")} unavailable (${d.why}) — continuing without it`);
	return d;
}

export default function (pi: ExtensionAPI) {
	// Session context (principles:session) is collected at session start and
	// re-asserted on every run: pi's session_start cannot add context itself, so
	// it rides the system prompt that before_agent_start builds.
	let sessionContext = "";
	let stopActive = false;
	// A gate still going at settle has exactly one waiter (armWaiter).
	let waiterArmed = false;

	// PreToolUse -> gate (edit/write) and commitgate (bash), through the wrapper.
	pi.on("tool_call", async (event: any, ctx: any) => {
		const toolName = String(event?.toolName ?? "");
		const b = toolBinding(toolName);
		if (!b) return undefined;
		const input = event?.input ?? {};
		const isBash = toolName === "bash";
		const toolInput: Record<string, unknown> = isBash
			? { command: input.command }
			: { ...input, file_path: input.path ?? input.file_path };
		const payload = claudeEvent("PreToolUse", ctx, {
			tool_name: CLAUDE_TOOL[toolName] ?? toolName,
			tool_input: toolInput,
		});
		const r = await run("sh", [WRAPPER, b.verb, "pi"], payload, workdir(ctx), b.timeout_s);
		const v = wrapperVerdict(r);
		if (v.kind === "deny") return { block: true, reason: v.reason };
		if (v.kind === "allow") return undefined;
		// satelle could not decide. Mirror the wrapper: non-mutating bash stays
		// allowed so the agent can diagnose; an edit or a commit/push is refused.
		if (isBash && !MUTATING_GIT.test(String(input.command ?? ""))) return undefined;
		return {
			block: true,
			reason: `satelle hook wrapper unavailable: ${v.why} — INFRASTRUCTURE failure, NOT a policy denial. Try: which satelle; satelle init.`,
		};
	});

	// SessionStart -> context (after the reindex the other scaffolds run first).
	pi.on("session_start", async (_event: any, ctx: any) => {
		const parts: string[] = [];
		for (const b of bindingsFor("session_start")) {
			const d = await runDirect(b, claudeEvent("SessionStart", ctx, { source: "startup" }), ctx);
			const add = d.ok ? d.doc?.hookSpecificOutput?.additionalContext : undefined;
			if (typeof add === "string" && add.trim()) parts.push(add);
		}
		sessionContext = parts.join("\n\n");
	});

	// UserPromptSubmit -> prompt. The reminder joins the session context in the
	// system prompt for this run.
	pi.on("before_agent_start", async (event: any, ctx: any) => {
		const parts: string[] = [];
		if (sessionContext) parts.push(sessionContext);
		for (const b of bindingsFor("before_agent_start")) {
			const d = await runDirect(b, claudeEvent("UserPromptSubmit", ctx, { prompt: String(event?.prompt ?? "") }), ctx);
			const add = d.ok ? d.doc?.hookSpecificOutput?.additionalContext : undefined;
			if (typeof add === "string" && add.trim()) parts.push(add);
		}
		if (parts.length === 0) return undefined;
		return { systemPrompt: `${event?.systemPrompt ?? ""}\n\n${parts.join("\n\n")}` };
	});

	// One Stop question: stopcheck's block (a verdict or a refused stop), and
	// whether a gate it named is still going. noWake is the non-interactive case
	// (see the header).
	async function stopQuestion(ctx: any, noWake: boolean): Promise<{ block?: string; pending: boolean }> {
		let block: string | undefined;
		let pending = false;
		for (const b of bindingsFor("agent_settled")) {
			const d = await runDirect(b, claudeEvent("Stop", ctx, { stop_hook_active: stopActive }), ctx, noWake ? ["--no-wake"] : []);
			if (!d.ok) continue;
			if (d.doc?.decision === "block") block = String(d.doc.reason ?? "satelle: stop refused");
			else {
				if (typeof d.doc?.systemMessage === "string") notify(ctx, d.doc.systemMessage, "info");
				if (Array.isArray(d.doc?.pending) && d.doc.pending.length > 0) pending = true;
			}
		}
		return { block, pending };
	}

	function sendBlock(ctx: any, block: string): void {
		try {
			if (ctx?.isIdle?.() ?? true) pi.sendUserMessage(block);
			else pi.sendUserMessage(block, { deliverAs: "followUp" });
		} catch (e) {
			notify(ctx, `satelle could not deliver the stop refusal: ${String(e)}`);
		}
	}

	// The one waiter for a gate still going at settle. Each pass is stopcheck's own
	// blocking wait on the handle, bounded by the hook's timeout — not a timer and
	// not a poll — and the loop ends when no gate is pending any more. It never
	// sends a still-running note: only a verdict becomes a message.
	function armWaiter(ctx: any): void {
		waiterArmed = true;
		process.once("exit", () => children.forEach((c) => c.kill("SIGKILL")));
		void (async () => {
			try {
				for (;;) {
					const started = Date.now();
					const q = await stopQuestion(ctx, false);
					stopActive = q.block !== undefined;
					if (q.block !== undefined) sendBlock(ctx, q.block);
					// A pending answer that came back at once was no wait (the hook's
					// bound is zero): looping on it would be a poll. The verdict still
					// reaches the next prompt.
					if (!q.pending || Date.now() - started < 1000) break;
				}
			} finally {
				waiterArmed = false;
			}
		})();
	}

	// Stop -> stopcheck. See the header: a re-prompt, not a veto.
	pi.on("agent_settled", async (_event: any, ctx: any) => {
		const interactive = Boolean(ctx?.hasUI);
		const q = await stopQuestion(ctx, !interactive);
		stopActive = q.block !== undefined;
		if (q.block !== undefined) sendBlock(ctx, q.block);
		if (q.pending && !waiterArmed) armWaiter(ctx);
	});
}
