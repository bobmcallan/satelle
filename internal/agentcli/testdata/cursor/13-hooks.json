{
 "version": 1,
 "hooks": {
  "sessionStart": [
   {
    "command": "cursorprobe13 bare-path-lookup"
   },
   {
    "command": "PATH=/SCRATCH/out/13-bin:$PATH cursorprobe13 env-prefix-path"
   },
   {
    "command": "/SCRATCH/out/13-bin/cursorprobe13 absolute"
   },
   {
    "command": "sh -c 'cursorprobe13 sh-c-path'"
   }
  ]
 }
}
