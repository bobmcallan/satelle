{
  "id": "default-planner-study",
  "seed": 20260730,
  "runs": 3,
  "min_samples": 3,
  "binding_change_p50_gap_percent": 25,

  "context_buckets": [
    { "name": "small", "max_bytes": 6144 },
    { "name": "medium", "max_bytes": 24576 },
    { "name": "large", "max_bytes": 0 }
  ],

  "bindings": [
    {
      "id": "claude-command-opus",
      "provider": "anthropic",
      "model": "opus",
      "effort": "high",
      "interface": "command",
      "command": "claude -p --output-format json --disallowedTools Write,Edit,NotebookEdit --append-system-prompt {system} --allowedTools {tools} --model {model} --effort {effort}"
    },
    {
      "id": "claude-command-sonnet",
      "provider": "anthropic",
      "model": "sonnet",
      "effort": "high",
      "interface": "command",
      "command": "claude -p --output-format json --disallowedTools Write,Edit,NotebookEdit --append-system-prompt {system} --allowedTools {tools} --model {model} --effort {effort}"
    },
    {
      "id": "codex-command-o4mini",
      "provider": "openai",
      "model": "o4-mini",
      "effort": "high",
      "interface": "command",
      "command": "codex exec -s read-only -m {model} -c model_reasoning_effort=\"{effort}\" {system}",
      "tools": "read_file,grep,list_dir,Bash(satelle:*)",
      "tool_policy": "codex-native-read-only",
      "tool_policy_divergence": {
        "reason": "Codex does not accept Claude tool names; the grant is the provider-native spelling, so it is a sample variable rather than the shipped grant."
      }
    },
    {
      "id": "codex-acp-o4mini",
      "provider": "openai",
      "model": "o4-mini",
      "effort": "high",
      "interface": "acp",
      "command": "npx -y @agentclientprotocol/codex-acp",
      "tools": "read_file,grep,list_dir,Bash(satelle:*)",
      "tool_policy": "codex-native-read-only",
      "tool_policy_divergence": {
        "reason": "Same provider-native grant as the codex command binding, so the transport pair holds tool policy constant while interface varies."
      }
    },
    {
      "id": "grok-acp-45",
      "provider": "xai",
      "model": "grok-4.5",
      "effort": "high",
      "interface": "acp",
      "command": "grok agent stdio",
      "tools": "read_file,grep,list_dir,Bash(satelle:*)",
      "tool_policy": "grok-native-read-only",
      "tool_policy_divergence": {
        "reason": "Grok tool names differ from the shipped Claude grant; recorded as a sample variable so no comparison reads it as the shipped policy."
      }
    },
    {
      "id": "inloop-executor",
      "provider": "anthropic",
      "model": "opus",
      "effort": "high",
      "interface": "command",
      "topology": "in_loop",
      "tools": "session-full-grant",
      "tool_policy": "driving-session-grant",
      "tool_policy_divergence": {
        "reason": "The in-loop executor is the driving session and carries its full interactive grant including write tools; it is not the read-only planner grant and must never be labelled as one."
      }
    }
  ],

  "comparisons": [
    {
      "id": "transport-codex-o4mini",
      "free_variable": "interface",
      "holds": ["provider", "model", "effort_class", "tool_policy", "topology", "fixture", "context_size_bucket"],
      "members": ["codex-command-o4mini", "codex-acp-o4mini"],
      "description": "Command template versus ACP for one provider, model, effort class and grant."
    },
    {
      "id": "model-claude-command",
      "free_variable": "model",
      "holds": ["provider", "interface", "effort_class", "tool_policy", "topology", "fixture", "context_size_bucket"],
      "members": ["claude-command-opus", "claude-command-sonnet"],
      "description": "Two models of one provider on a fixed interface with the shipped grant."
    },
    {
      "id": "provider-acp-high",
      "free_variable": "provider",
      "holds": ["interface", "effort_class", "tool_policy", "topology", "fixture", "context_size_bucket"],
      "members": ["codex-acp-o4mini", "grok-acp-45"],
      "description": "Two providers on ACP. Declared deliberately: their native tool vocabularies are different grants, so the report is expected to name this confounded rather than pick a provider."
    },
    {
      "id": "topology-claude-opus",
      "free_variable": "topology",
      "holds": ["provider", "model", "effort_class", "fixture"],
      "members": ["claude-command-opus", "inloop-executor"],
      "description": "Isolated dispatch versus the in-loop executor. Tool policy necessarily differs and collection methods differ, so the conclusion is always qualified and never justifies a default change."
    }
  ]
}
