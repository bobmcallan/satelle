--- a/internal/substratereview/judge.go
+++ b/internal/substratereview/judge.go
@@ -40,6 +40,24 @@ type judgePayload struct {
 	Rules    []Rule        `json:"rules"`
 }
 
+// buildJudgePayload hands the reviewer seat everything it judges: every
+// substrate item's text and every recorded rejection note, so the judge needs
+// nothing else.
+func buildJudgePayload(items []Item, ev map[ItemKey]Evidence, rules []Rule) (judgePayload, error) {
+	p := judgePayload{Rules: rules}
+	for _, it := range items {
+		body, err := os.ReadFile(it.Path)
+		if err != nil {
+			return judgePayload{}, err
+		}
+		e := ev[it.Key()]
+		p.Items = append(p.Items, judgedItem{
+			Key: it.Key(), Origin: it.Origin, Body: string(body),
+			RejectionNotes: e.Reasons, DissentNotes: e.DissentNotes,
+		})
+	}
+	return p, nil
+}
