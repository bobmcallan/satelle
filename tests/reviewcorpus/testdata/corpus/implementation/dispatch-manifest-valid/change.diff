--- a/internal/substratereview/judge.go
+++ b/internal/substratereview/judge.go
@@ -40,6 +40,24 @@ type judgePayload struct {
 	Rules    []Rule        `json:"rules"`
 }
 
+// buildJudgePayload hands the reviewer seat its instruction and a manifest.
+// The seat has a read grant and the satelle CLI, so it reads each item and its
+// history itself; no body or note is copied here (satelle-dispatch-pointers).
+func buildJudgePayload(items []Item, ev map[ItemKey]Evidence, rules []Rule) judgePayload {
+	p := judgePayload{Rules: rules}
+	for _, it := range items {
+		e := ev[it.Key()]
+		p.Items = append(p.Items, manifestItem{
+			Key: it.Key(), Origin: it.Origin, Path: it.Path,
+			Rejections: e.Rejections, Stories: e.StoryIDs,
+			Read:       fmt.Sprintf("satelle doc get %s %s", it.Kind, it.Name),
+			History:    "satelle ledger list --story <id>",
+		})
+	}
+	return p
+}
