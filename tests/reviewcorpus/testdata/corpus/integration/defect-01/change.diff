--- /dev/null
+++ b/internal/verb/driver_usage_recorder_test.go
@@ -0,0 +1,58 @@
+package verb
+
+import (
+	"testing"
+	"time"
+)
+
+// TestRecordDriverUsageEngage asserts the row written on an engage trigger.
+func TestRecordDriverUsageEngage(t *testing.T) {
+	ctx, it := newTestStory(t)
+	recordDriverUsage(ctx, it, "", "plan", time.Now())
+	rows := ledgerDriverUsageRows(t, ctx, it.ID)
+	if len(rows) != 1 || rows[0].Trigger != DriverTriggerEngage {
+		t.Fatalf("got %+v, want one engage row", rows)
+	}
+}
+
+// TestRecordDriverUsageTransition asserts the row written on an ordinary
+// status transition.
+func TestRecordDriverUsageTransition(t *testing.T) {
+	ctx, it := newTestStory(t)
+	recordDriverUsage(ctx, it, "plan", "in_progress", time.Now())
+	rows := ledgerDriverUsageRows(t, ctx, it.ID)
+	if len(rows) != 1 || rows[0].Trigger != DriverTriggerTransition {
+		t.Fatalf("got %+v, want one transition row", rows)
+	}
+}
+
+// TestRecordDriverUsageClose asserts the row written on a terminal close,
+// including a Pending row when the driver's usage is still flushing.
+func TestRecordDriverUsageClose(t *testing.T) {
+	ctx, it := newTestStory(t)
+	recordDriverUsage(ctx, it, "release", "done", time.Now())
+	rows := ledgerDriverUsageRows(t, ctx, it.ID)
+	if len(rows) != 1 {
+		t.Fatalf("got %+v, want one close row", rows)
+	}
+	if rows[0].Pending {
+		t.Logf("close row is pending, swept later")
+	}
+}
+
+// TestRecordDriverUsageRetryIsNoOp asserts AC7: re-issuing the same delta
+// writes nothing.
+func TestRecordDriverUsageRetryIsNoOp(t *testing.T) {
+	ctx, it := newTestStory(t)
+	recordDriverUsage(ctx, it, "plan", "in_progress", time.Now())
+	recordDriverUsage(ctx, it, "plan", "in_progress", time.Now())
+	rows := ledgerDriverUsageRows(t, ctx, it.ID)
+	if len(rows) != 1 {
+		t.Fatalf("got %d rows, want exactly one (retry must be a no-op)", len(rows))
+	}
+}
+
+// Every case above calls recordDriverUsage directly. None drives workItemSet
+// (the single production call site, internal/verb/workitem.go:736) or
+// runRoot "story set", so deleting that call site would leave this file green.
