--- a/internal/verb/driver_usage_recorder_test.go
+++ b/internal/verb/driver_usage_recorder_test.go
@@ -55,3 +55,52 @@
 // Every case above calls recordDriverUsage directly. None drives workItemSet
 // (the single production call site, internal/verb/workitem.go:736) or
 // runRoot "story set", so deleting that call site would leave this file green.
+
+// TestWorkItemSetRecordsDriverUsagePerTransition drives real transitions
+// through the workItemSet dispatch seam with a stub driverSnapshotter and a
+// session env, so deleting the recordDriverUsage call in workItemSet (or
+// moving it outside the transitioning block) fails this test.
+func TestWorkItemSetRecordsDriverUsagePerTransition(t *testing.T) {
+	ctx, it := newTestStory(t)
+	snap := newStubDriverSnapshotter(t)
+	withDriverSnapshotter(t, snap)
+	withSessionEnv(t, "sess-A")
+
+	engage := mustWorkItemSet(t, ctx, it.ID, "plan")
+	transition := mustWorkItemSet(t, ctx, it.ID, "in_progress")
+	park := mustWorkItemSet(t, ctx, it.ID, "blocked")
+	_ = mustWorkItemSet(t, ctx, it.ID, "in_progress") // resume
+	closeRow := mustWorkItemSet(t, ctx, it.ID, "done")
+
+	rows := ledgerDriverUsageRows(t, ctx, it.ID)
+	wantTriggers := []DriverTrigger{
+		DriverTriggerEngage,
+		DriverTriggerTransition,
+		DriverTriggerPark,
+		DriverTriggerTransition,
+		DriverTriggerClose,
+	}
+	if len(rows) != len(wantTriggers) {
+		t.Fatalf("got %d driver_usage rows, want %d: %+v", len(rows), len(wantTriggers), rows)
+	}
+	for i, want := range wantTriggers {
+		if rows[i].Trigger != want {
+			t.Errorf("row %d: trigger %v, want %v", i, rows[i].Trigger, want)
+		}
+	}
+	_ = engage
+	_ = transition
+	_ = park
+	_ = closeRow
+
+	// AC7 end to end: re-issuing the same terminal transition writes nothing.
+	_ = mustWorkItemSetExpectNoOp(t, ctx, it.ID, "done")
+	rowsAfterRetry := ledgerDriverUsageRows(t, ctx, it.ID)
+	if len(rowsAfterRetry) != len(wantTriggers) {
+		t.Fatalf("retry wrote %d extra rows, want 0", len(rowsAfterRetry)-len(wantTriggers))
+	}
+}
